---
import { getCollection } from "astro:content";
import { formatDateRange } from "../utils/date";

interface Props {
  limit?: number;
}

const { limit = 4 } = Astro.props;

const news = (await getCollection("news"))
  .sort(
    (a, b) =>
      b.data.startDate.getTime() -
      a.data.startDate.getTime()
  )
  .slice(0, limit);
---

<div class="news-list">
  {news.map((item) => (
    <article class="news-item">
      <p class="news-date">
        {formatDateRange(item.data.startDate, item.data.endDate)}
      </p>

      <h3>
        {item.data.link ? (
          <a href={item.data.link}>{item.data.title}</a>
        ) : (
          item.data.title
        )}
      </h3>

      {item.data.location && (
        <p class="news-location">{item.data.location}</p>
      )}
    </article>
  ))}
</div>