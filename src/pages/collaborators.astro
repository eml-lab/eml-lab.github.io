---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/collaborators.css";
import { getCollection } from "astro:content";

const collaborators = await getCollection("collaborators");

collaborators.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Collaborators">

    <!-- Banner Section -->
    <section class="banner">
        <div class="banner-content">
            <h1>Collaborators</h1>
            <p>Research partners and joint projects across economics, policy, finance, and machine learning</p>
        </div>
    </section>

    <!-- Main Content -->
    <div class="container collaborators-layout">
        <main class="main-content">

            <section class="page-intro">
                <h2>Research Collaborations</h2>
                <p>
                    The Economic Machine Learning Lab collaborates with researchers across institutions and fields on projects
                    that use modern statistical and machine learning methods to study economic questions.
                </p>
            </section>

            <section class="collaborators-grid" aria-label="Collaborators">

                {collaborators.map((person) => (

                    <article class="collaborator-card">

                        <img
                            src={person.data.image}
                            alt={person.data.name}
                            class="collaborator-image"
                        />

                        <div class="collaborator-info">

                            <h3 class="collaborator-name">
                                {person.data.name}
                            </h3>

                            <p class="collaborator-affiliation">
                                <a
                                    href={person.data.affiliationUrl}
                                    class="institution-link"
                                >
                                    {person.data.affiliation}
                                </a>
                            </p>

                            <p class="collaborator-specialty">
                                {person.data.specialty}
                            </p>

                            <div class="project-block">
                                <p class="project-label">
                                    Joint Project
                                </p>

                                <h4 class="project-title">
                                    {person.data.project}
                                </h4>
                            </div>

                            <div class="collaborator-links">
                                <a
                                    href={person.data.website}
                                    class="collaborator-link"
                                >
                                    Personal Website
                                </a>
                            </div>

                        </div>

                    </article>

                ))}

            </section>

        </main>
    </div>

</BaseLayout>