---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/contact.css";
---

<BaseLayout title="Contact | Economic Machine Learning Lab">

<!-- Banner Section -->
    <section class="banner">
        <div class="banner-content">
            <h1>Contact</h1>
            <p>Contact the Economic Machine Learning Lab</p>
        </div>
    </section>

    <!-- Main Content -->
    <div class="container contact-layout">
        <main class="main-content">
            <div class="contact-container">
                <section class="contact-main">
                    <h2>Contact the Lab</h2>
                    <p>
                        For questions about the Economic Machine Learning Lab, please contact us by email.
                        We welcome inquiries related to research, events, workshops, courses, and student opportunities.
                    </p>

                    <div class="email-card">
                        <h3>Email</h3>
                        <a href="mailto:emllab@iu.edu">emllab@iu.edu</a>
                    </div>

                    <div class="inquiry-list">
                        <h3>Common Inquiries</h3>
                        <div class="inquiry-item">Research collaborations and lab projects</div>
                        <div class="inquiry-item">Workshops, courses, and training opportunities</div>
                        <div class="inquiry-item">Seminars, conferences, and lab events</div>
                        <div class="inquiry-item">Student fellow opportunities and participation</div>
                        <div class="inquiry-item">General questions about the lab</div>
                    </div>
                </section>

                <aside class="contact-side">
                    <h3>Visit Us</h3>
                    <div class="address-block">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                            <circle cx="12" cy="10" r="3"/>
                        </svg>
                        <div>
                            <p>Department of Economics</p>
                            <p>Indiana University</p>
                            <p>100 S Woodlawn Ave</p>
                            <p>Bloomington, IN 47405</p>
                        </div>
                    </div>

                    <div class="note-box">
                        Please use the lab email for general inquiries. For questions directed to a specific faculty member or student fellow, visit the relevant people page for individual contact information.
                    </div>
                </aside>
            </div>
        </main>
    </div>

</BaseLayout>