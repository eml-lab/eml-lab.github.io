                    </div>
                    <ul class="presenter-list">
                        <li class="presenter-item">
                            <div class="presenter-name">Yoosoon Chang</div>
                            <div class="presenter-affiliation">Indiana University<br>EML Lab Executive Director</div>
                        </li>
                        <li class="presenter-item">
                            <div class="presenter-name">Joon Park</div>
