---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DashboardContainer from "../../components/DashboardContainer.astro";
import "../../styles/dashboard-page.css";
---

<BaseLayout title="Energy Dashboard | Economic Machine Learning Lab">
    <section class="banner">
        <div class="banner-content">
            <h1>Energy Dashboard</h1>
            <p>Interactive electricity load forecasts.</p>
        </div>
    </section>

    <div class="dashboard-page-layout">
        <DashboardContainer title="" description="">
            <iframe
                src="https://b2p-dashboard-eml.plotly.app/"
                title="Energy Dashboard"
                loading="lazy"
                allowfullscreen
                style="display: block; width: 100%; height: 1250px; border: 0; background: white;"
            ></iframe>
        </DashboardContainer>

        <section class="dashboard-navigation">
            <a class="dashboard-back-link" href="/dashboards">
                ← Back to Research Dashboards
            </a>
        </section>
    </div>
</BaseLayout>
