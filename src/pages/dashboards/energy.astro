---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DashboardContainer from "../../components/DashboardContainer.astro";
import "../../styles/dashboard-page.css";
import LoadForecasterDashboard from "../../components/dashboards/LoadForecasterDashboard.jsx";
---

<BaseLayout title="Energy Dashboards | Economic Machine Learning Lab">

    <!-- Banner -->
    <section class="banner">
        <div class="banner-content">
            <h1>Energy Dashboards</h1>
            <p>Interactive tools for exploring research in energy economics.</p>
        </div>
    </section>

    <div class="dashboard-page-layout">

        <section class="dashboard-page-intro">

            <h2>Energy Research</h2>

            <p>
                This page hosts interactive dashboards developed by the Economic
                Machine Learning Lab to explore topics in energy economics.
                Future dashboards will provide interactive visualizations,
                forecasting tools, and data exploration interfaces supporting
                ongoing research.
            </p>

        </section>

        <DashboardContainer
            title="EML Load Forecaster Dashboard"
            description="Interactive electricity load forecasts and forecast decomposition."
        >
            <LoadForecasterDashboard client:only="react" />
        </DashboardContainer>

        <section class="dashboard-page-section">

            <h2>Research Areas</h2>

            <div class="research-grid">

                <div class="research-tag">Electricity Markets</div>

                <div class="research-tag">Energy Forecasting</div>

                <div class="research-tag">Renewable Energy</div>

                <div class="research-tag">Power Systems</div>

                <div class="research-tag">Machine Learning Applications</div>
            </div>

        </section>

        <section class="dashboard-navigation">

            <a
                class="dashboard-back-link"
                href="/dashboards"
            >
                ← Back to Research Dashboards
            </a>
        </section>

    </div>

</BaseLayout>