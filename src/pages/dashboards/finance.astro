---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DashboardContainer from "../../components/DashboardContainer.astro";
import "../../styles/dashboard-page.css";
---

<BaseLayout title="Finance Dashboards | Economic Machine Learning Lab">

    <!-- Banner -->
    <section class="banner">
        <div class="banner-content">
            <h1>Finance Dashboards</h1>
            <p>Interactive tools for exploring research in finance.</p>
        </div>
    </section>

    <div class="dashboard-page-layout">

        <section class="dashboard-page-intro">

            <h2>Finance Research</h2>

            <p>
                This page hosts interactive dashboards developed by the Economic
                Machine Learning Lab to explore topics in financial economics.
                Future dashboards will provide interactive visualizations,
                forecasting tools, and data exploration interfaces supporting
                ongoing research.
            </p>

        </section>

        <DashboardContainer
            title="Featured Dashboard"
            description="This space will host an interactive finance dashboard once it is available."
        />

        <section class="dashboard-page-section">

            <h2>Research Areas</h2>

            <div class="research-grid">

                <div class="research-tag">Asset Pricing</div>

                <div class="research-tag">Financial Markets</div>

                <div class="research-tag">Risk Management</div>

                <div class="research-tag">Portfolio Analysis</div>

                <div class="research-tag">Machine Learning Applications</div>
            </div>

        </section>

        <section class="dashboard-navigation">

            <a
                class="dashboard-back-link"
                href="/dashboards"
            >
                ← Back to Research Dashboards
            </a>
        </section>

    </div>

</BaseLayout>