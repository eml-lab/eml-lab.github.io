---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/presentations.css";
import { getCollection } from "astro:content";

const presentations = await getCollection("presentations");

const upcoming = presentations
    .filter((entry) => entry.data.category === "upcoming")
    .sort((a, b) => a.data.order - b.data.order);

const archived = presentations
    .filter((entry) => entry.data.category === "archive")
    .sort((a, b) => {
        if (a.data.year !== b.data.year) {
            return b.data.year - a.data.year;
        }

        return a.data.order - b.data.order;
    });

const archiveYears = [...new Set(archived.map((entry) => entry.data.year))]
    .sort((a, b) => b - a);
---

<BaseLayout title="Presentations">

    <section class="banner">
        <div class="banner-content">
            <h1>Presentations</h1>
            <p>Conference presentations and keynote speeches by EML-Lab researchers</p>
        </div>
    </section>

    <div class="container presentations-layout">
        <main class="main-content">
            <section class="presentations-intro">
                <h2>EML Presentations</h2>
                <p>
                    EML researchers share their work through keynote speeches, invited talks,
                    conference presentations, and workshops around the world.
                </p>
                <p>
                    Upcoming presentations are highlighted first. Past presentations are organized
                    in a collapsible archive by year so visitors can explore earlier events when needed.
                </p>
            </section>

            <section class="presentation-section">
                <h2>Upcoming Presentations</h2>

                <div class="upcoming-grid">
                    {upcoming.map((presentation) => (
                        <div class="presentation-card featured-presentation-card">
                            <div class="presentation-header upcoming-header">
                                <h3>{presentation.data.title}</h3>
                            </div>

                            <div class="presentation-content">
                                {presentation.data.descriptionHtml.map((paragraph) => (
                                    <p
                                        class="presentation-paragraph"
                                        set:html={paragraph}
                                    ></p>
                                ))}

                                <div class="presentation-meta">
                                    <div class="meta-item">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                            <line x1="16" y1="2" x2="16" y2="6"></line>
                                            <line x1="8" y1="2" x2="8" y2="6"></line>
                                            <line x1="3" y1="10" x2="21" y2="10"></line>
                                        </svg>
                                        <span>{presentation.data.date}</span>
                                    </div>

                                    <div class="meta-item">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                            <circle cx="12" cy="10" r="3"></circle>
                                        </svg>
                                        <span>{presentation.data.location}</span>
                                    </div>

                                    {presentation.data.speaker && (
                                        <div class="meta-item">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                                <circle cx="12" cy="7" r="4"></circle>
                                            </svg>
                                            <span>{presentation.data.speaker}</span>
                                        </div>
                                    )}
                                </div>

                                {presentation.data.links.length > 0 && (
                                    <div class="presentation-links">
                                        {presentation.data.links.map((link) => (
                                            <a
                                                href={link.url}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="presentation-link"
                                            >
                                                {link.title}
                                            </a>
                                        ))}
                                    </div>
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            </section>

            <details class="archive-details">
                <summary>Presentation Archive</summary>

                <div class="archive-content">
                    {archiveYears.map((year) => (
                        <section class="year-section">
                            <h2 class="year-header">{year} Presentations</h2>

                            <div class="presentation-grid">
                                {archived
                                    .filter((presentation) => presentation.data.year === year)
                                    .map((presentation) => (
                                        <div class="presentation-card">
                                            <div class="presentation-header">
                                                <h3>{presentation.data.title}</h3>
                                            </div>

                                            <div class="presentation-content">
                                                {presentation.data.descriptionHtml.map((paragraph) => (
                                                    <p
                                                        class="presentation-paragraph"
                                                        set:html={paragraph}
                                                    ></p>
                                                ))}

                                                <div class="presentation-meta">
                                                    <div class="meta-item">
                                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                                            <line x1="16" y1="2" x2="16" y2="6"></line>
                                                            <line x1="8" y1="2" x2="8" y2="6"></line>
                                                            <line x1="3" y1="10" x2="21" y2="10"></line>
                                                        </svg>
                                                        <span>{presentation.data.date}</span>
                                                    </div>

                                                    <div class="meta-item">
                                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                                            <circle cx="12" cy="10" r="3"></circle>
                                                        </svg>
                                                        <span>{presentation.data.location}</span>
                                                    </div>

                                                    {presentation.data.speaker && (
                                                        <div class="meta-item">
                                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                                                <circle cx="12" cy="7" r="4"></circle>
                                                            </svg>
                                                            <span>{presentation.data.speaker}</span>
                                                        </div>
                                                    )}
                                                </div>

                                                {presentation.data.links.length > 0 && (
                                                    <div class="presentation-links">
                                                        {presentation.data.links.map((link) => (
                                                            <a
                                                                href={link.url}
                                                                target="_blank"
                                                                rel="noopener noreferrer"
                                                                class="presentation-link"
                                                            >
                                                                {link.title}
                                                            </a>
                                                        ))}
                                                    </div>
                                                )}

                                                {presentation.data.photos.length > 0 && (
                                                    <div class="wkf-photos">
                                                        <h4 class="event-photos-heading">
                                                            Event Photos
                                                        </h4>

                                                        <div class="simple-photo-gallery">
                                                            {presentation.data.photos.map((photo) => (
                                                                <div class="simple-photo-item">
                                                                    <div class="photo-frame">
                                                                        <img
                                                                            src={photo.src}
                                                                            alt={photo.alt}
                                                                            loading="lazy"
                                                                        />
                                                                    </div>

                                                                    <p class="simple-photo-caption">
                                                                        {photo.caption}
                                                                    </p>
                                                                </div>
                                                            ))}
                                                        </div>
                                                    </div>
                                                )}
                                            </div>
                                        </div>
                                    ))}
                            </div>
                        </section>
                    ))}
                </div>
            </details>
        </main>
    </div>

</BaseLayout>
